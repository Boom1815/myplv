# Copie ce fichier en .env et remplis les valeurs. Ne jamais committer .env.

# --- Base de données (Neon Postgres, plan gratuit) ---
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Application ---
APP_URL=https://app.myplv.be
NODE_ENV=development

# --- Authentification ---
# Chaîne aléatoire longue (32+ caractères) — génère avec `openssl rand -hex 32`
AUTH_SECRET=
# Nom + durée du cookie de session
SESSION_COOKIE_NAME=myplv_session
SESSION_TTL_HOURS=168

# --- Email (Brevo, plan gratuit) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=campagnes@myplv.be
EMAIL_FROM_NAME=MYPLV
EMAIL_DAILY_LIMIT=50

# --- Sources de données ---
# KBO/BCE Open Data : compte gratuit requis sur https://kbopub.economie.fgov.be/kbo-open-data/
KBO_OPEN_DATA_USERNAME=
KBO_OPEN_DATA_PASSWORD=
# CBE API (tiers, optionnel, enrichissement ponctuel uniquement)
CBE_API_KEY=

# --- Jobs planifiés ---
# Secret partagé pour authentifier les appels GitHub Actions -> API
CRON_SECRET=
