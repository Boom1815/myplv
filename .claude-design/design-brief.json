{
  "scope": "page",
  "isRedesign": true,
  "targetPath": "apps/web/src/pages/Dashboard.tsx",
  "targetName": "Dashboard (représentatif du système de design partagé : topbar, cartes, tableaux, badges)",
  "painPoints": ["Trop froid/impersonnel", "Hiérarchie peu claire", "Manque de vie/de feedback (aucune animation)"],
  "inspiration": {
    "visual": ["Linear"],
    "functional": ["hover states", "transitions douces", "feedback visuel immédiat"]
  },
  "brand": {
    "adjectives": ["clair", "moderne", "aligné", "coloré-mais-sobre", "digne de confiance"],
    "density": "comfortable",
    "darkMode": false
  },
  "persona": {
    "primary": "Utilisateur métier (équipe prospection MYPLV, interne)",
    "context": "desktop-first",
    "keyTasks": ["Scanner les KPI du dashboard", "Parcourir/filtrer les prospects", "Gérer campagnes et templates email"]
  },
  "constraints": {
    "mustKeep": ["structure de navigation", "libellés existants"],
    "technical": ["aucune nouvelle dépendance", "réutiliser les composants existants (.btn, .card-block, etc.)"]
  },
  "framework": "vite-react (SPA, pas de routeur)",
  "packageManager": "npm",
  "stylingSystem": "CSS custom properties (apps/web/src/styles/global.css)",
  "colorConstraint": {
    "source": "apps/web/public/logo-myplv.png (caméléon géométrique)",
    "hues": {
      "orange": "#E05010 / #E02020",
      "bleu": "#1090D0 / #2070B0",
      "magenta": "#901080 / #E00070 / #C01070"
    },
    "rule": "1 accent primaire + 1-2 secondaires max, base neutre claire conservée — pas d'interface 'arc-en-ciel'"
  }
}
